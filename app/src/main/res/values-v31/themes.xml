<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Elophia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/elophia_navy</item>
        <item name="android:navigationBarColor">@color/elophia_navy</item>
    </style>

    <style name="Theme.Elophia.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/elophia_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Elophia</item>
    </style>

</resources>